<Window x:Class="PgrVoice.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="战双 · 剧情配音" Icon="Assets/PgrVoice.ico" Width="64" Height="64" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnPreviewKey">
 <Grid>
  <Border x:Name="BallView" Background="{StaticResource BallNormal}" CornerRadius="23" BorderBrush="{StaticResource NormalAccent}" BorderThickness="1" MouseLeftButtonDown="BallDown" MouseMove="BallMove" MouseLeftButtonUp="BallUp" ToolTip="单击查看台词 · 拖动移动 · F6 展开">
   <Grid><Border Width="18" Height="2" Background="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,7,0,0"/><StackPanel VerticalAlignment="Center" Margin="0,4,0,0"><TextBlock x:Name="BallGlyph" Text="声" FontSize="23" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="BallState" Text="待开始" FontSize="9" TextAlignment="Center" Foreground="{StaticResource MutedText}"/></StackPanel></Grid>
  </Border>
  <Border x:Name="StripView" Visibility="Collapsed" Background="{StaticResource Bg}" BorderBrush="{StaticResource NormalAccent}" BorderThickness="1" CornerRadius="4" Padding="12,8" MouseLeftButtonDown="StripDrag">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StripSpeaker" Foreground="{StaticResource NormalAccent}" FontSize="11"/><ScrollViewer MaxHeight="86" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StripText" Text="等待确认播放" FontSize="{DynamicResource CurrentDialogueSize}"/></ScrollViewer><TextBlock x:Name="StripState" FontSize="10" Foreground="{StaticResource MutedText}"/></StackPanel><Button Grid.Column="1" Content="展开" Click="StripExpandClick" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Margin="6,0,0,0"/></Grid>
  </Border>
  <Border x:Name="PanelView" Visibility="Collapsed" Background="{StaticResource Bg}" CornerRadius="5" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
   <Grid x:Name="PanelLayout">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Hero" Height="116" ClipToBounds="True" Background="{StaticResource Inset}" MouseLeftButtonDown="HeaderDrag">
     <Canvas IsHitTestVisible="False" Opacity="0.25"><Path Data="M300,0 L235,116 M440,0 L375,116 M560,0 L495,116" Stroke="{StaticResource Stroke}" StrokeThickness="24"/><Path Data="M0,114 L580,114" Stroke="{StaticResource Accent}" StrokeThickness="2"/></Canvas>
     <Image x:Name="HeroArtwork" Width="370" Height="208" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,0,0" IsHitTestVisible="False"/>
     <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF101214" Offset="0"/><GradientStop Color="#F5101214" Offset="0.28"/><GradientStop Color="#75101214" Offset="0.57"/><GradientStop Color="#15101214" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
     <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00151719" Offset="0.3"/><GradientStop Color="#DA151719" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
     <StackPanel x:Name="HeroTitleStack" Margin="18,16,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"><TextBlock x:Name="HeroEyebrow" Text="GRAY RAVEN  /  VOICE TERMINAL" FontFamily="Bahnschrift" FontSize="10" Foreground="{StaticResource MutedText}"/><StackPanel x:Name="HeroHeading" Orientation="Horizontal" Margin="0,8,0,0"><Border Width="3" Background="{StaticResource Accent}" Margin="0,3,9,3"/><TextBlock x:Name="HeroTitle" Text="剧情配音" FontSize="25" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="HeaderChapter" Text="选择章节，继续你的故事" FontSize="11" Foreground="{StaticResource MutedText}" MaxWidth="280" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,8,0,0"/></StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"><Button x:Name="CollapseButton" Content="收起 F6" Click="CollapseClick" Style="{StaticResource QuietButton}" Background="#D0151719" ToolTip="收起为悬浮球"/><Button Content="×" Click="QuitClick" Style="{StaticResource QuietButton}" Background="#D0151719" FontSize="17" Width="30" Margin="3,0,0,0" ToolTip="退出"/></StackPanel>
    </Grid>
    <Border x:Name="CurrentCard" Grid.Row="1" Background="{StaticResource CurrentCardNormal}" BorderThickness="2,0,0,0" BorderBrush="{StaticResource Stroke}" CornerRadius="2" Padding="12,9" Margin="16,0,16,9">
     <StackPanel><DockPanel><TextBlock x:Name="StateText" DockPanel.Dock="Right" Text="待开始" FontSize="10" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0"/><TextBlock x:Name="CurrentSpeaker" Text="当前台词" Foreground="{StaticResource NormalAccent}" FontSize="11" FontWeight="SemiBold"/></DockPanel>
      <ScrollViewer x:Name="CurrentLineScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="84" Margin="0,5,0,0"><TextBlock x:Name="CurrentText" Text="浏览不会发声。确认台词后才播放。" FontSize="{DynamicResource CurrentDialogueSize}" LineHeight="{DynamicResource CurrentDialogueHeight}"/></ScrollViewer>
      <TextBlock x:Name="DraftNotice" Visibility="Collapsed" Foreground="{StaticResource BranchAccent}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Margin="16,0" Background="Transparent" BorderThickness="0" SelectionChanged="TabChanged">
     <TabItem Header="台词" x:Name="StoryTab"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ChapterColumn" Width="0"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,7"><TextBlock Text="章节" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="LibraryBox" DisplayMemberPath="DisplayTitle" SelectionChanged="LibraryChanged" ToolTip="从配音包总目录选择章节"/></StackPanel>
       <StackPanel x:Name="ChapterSelector" Grid.Column="1" Visibility="Collapsed" Margin="0,0,8,7"><TextBlock Text="包内章节" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="ChapterBox" SelectionChanged="ChapterChanged"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="小章节" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="SectionBox" SelectionChanged="SectionChanged"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,0,0,7"><WrapPanel x:Name="NavigationToolbar" Margin="0,0,0,5"><Button x:Name="InteractionsButton" Content="换人/话题 F1" Click="InteractionsClick" Style="{StaticResource QuietButton}"/><Button x:Name="ReselectButton" Content="重选 F3" Click="ReselectClick" Style="{StaticResource QuietButton}"/><Button x:Name="HistoryButton" Content="历史 F2" Click="HistoryClick" Style="{StaticResource QuietButton}"/><Button x:Name="UndoCorrectionButton" Content="撤销纠偏" Click="UndoCorrectionClick" Style="{StaticResource QuietButton}"/><Button Content="记住这里" Click="BookmarkClick" Style="{StaticResource QuietButton}"/><Button Content="回到当前句" Click="CurrentClick" Style="{StaticResource QuietButton}"/></WrapPanel><TextBlock x:Name="ChapterResumeLabel" Visibility="Collapsed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="SearchChapterBox" Grid.Column="1" Content="本章" Checked="SearchScopeChanged" Unchecked="SearchScopeChanged" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" TextChanged="SearchChanged" ToolTip="输入角色或台词搜索；清空可看全部" Padding="30,7,9,7"/><Path Data="M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 M11,11 L15,15" Stroke="{StaticResource SubtleText}" StrokeThickness="1.3" HorizontalAlignment="Left" VerticalAlignment="Center" Width="16" Height="16" Margin="9,0,0,0" IsHitTestVisible="False"/><TextBlock Text="搜索角色或台词…" Foreground="{StaticResource SubtleText}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel>
      <Border x:Name="BranchBox" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource RouteFill}" BorderBrush="{StaticResource BranchAccent}" BorderThickness="2,0,0,0" Padding="10" Margin="0,0,0,6"><StackPanel><TextBlock Text="◆ 分支选择 · 与游戏选择相同路线" Foreground="{StaticResource BranchAccent}" FontSize="11"/><ListBox x:Name="BranchList" ItemContainerStyle="{StaticResource BranchOptionStyle}" MaxHeight="100" Margin="0,5" MouseDoubleClick="BranchDoubleClick"/><Button Content="确认分支  ↵" Click="ConfirmBranchClick" BorderBrush="{StaticResource BranchAccent}" Padding="8,5"/></StackPanel></Border>
      <ListBox x:Name="LinesList" Grid.Row="3" MouseDoubleClick="LineDoubleClick" SelectionChanged="LineSelected"><ListBox.ItemTemplate><DataTemplate><Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="2,0,0,0" CornerRadius="2" Padding="10,8"><StackPanel><TextBlock Text="{Binding Caption}" Foreground="{Binding Accent}" FontSize="11"/><TextBlock Text="{Binding Text}" FontSize="{DynamicResource DialogueSize}" LineHeight="{DynamicResource DialogueHeight}" Margin="0,3,0,0"/><TextBlock Text="{Binding Context}" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     </Grid></TabItem>
     <TabItem Header="辅助定位" x:Name="LocateTab"><Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel><TextBlock x:Name="OcrInstructions" Text="先选小章节，再定位游戏当前台词。确认候选后才播放。" Foreground="{StaticResource MutedText}" FontSize="12"/><Button x:Name="LocateButton" Content="启用并定位" Click="LocateClick" Style="{StaticResource PrimaryButton}" Margin="0,10"/></StackPanel>
       <TextBlock x:Name="OcrScope" Grid.Row="1" Text="查找范围：剧情页选中的小章节" Foreground="{StaticResource MutedText}" FontSize="11"/>
       <TextBlock x:Name="OcrStatus" Grid.Row="2" Text="尚未识别" Margin="0,10" Foreground="{StaticResource NormalAccent}"/>
       <ListBox x:Name="CandidatesList" Grid.Row="3" MouseDoubleClick="CandidateDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,8"><TextBlock Text="{Binding Node.Speaker}" Foreground="{StaticResource NormalAccent}" FontSize="11"/><TextBlock Text="{Binding Node.Text}" Margin="0,4"/><TextBlock Text="{Binding Context}" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,4"/><TextBlock Text="{Binding Evidence}" FontSize="10" Foreground="{StaticResource SubtleText}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       <Expander Grid.Row="4" Header="查看识别到的文字" Foreground="{StaticResource MutedText}" Margin="0,7"><TextBox x:Name="OcrPreview" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"/></Expander>
       <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,6"><Button Click="ConfirmCandidateClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="确认定位并播放"/><Style.Triggers><DataTrigger Binding="{Binding SelectedItem.Node.Kind,ElementName=CandidatesList}" Value="choice"><Setter Property="Content" Value="打开此分支菜单（不播放）"/></DataTrigger><DataTrigger Binding="{Binding SelectedItem,ElementName=CandidatesList}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="取消定位" Click="CancelOcrClick" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></StackPanel>
      </Grid></TabItem>
     <TabItem Header="设置" x:Name="SettingsTab"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SettingsContent" Margin="0,12,6,0">
      <TextBlock Text="跟随方式在“游戏配音”页选择，这里设置游戏位置、按键与声音。" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,10"/>
      <Expander Header="游戏与配音包" IsExpanded="True" Margin="0,0,0,12"><StackPanel Margin="4,6,4,8">
      <TextBlock Text="配音包" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="PackLabel" Text="尚未选择" FontSize="12" Margin="0,0,0,7"/><Button Content="打开配音包或章节总目录…" Click="OpenPackClick"/>
      <TextBlock Text="战双游戏位置" Style="{StaticResource SectionLabel}" Margin="0,18,0,6"/>
      <TextBlock Text="选择你要使用的战双客户端目录，不限定服别或主程序名称。也可选择启动器所在文件夹，软件会检查下一层。文字跟随仍需客户端布局兼容、台词语言与配音包一致。" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,5"/>
      <WrapPanel><Button x:Name="SelectGameFolderButton" Content="选择战双游戏文件夹…" Click="SelectGameFolderClick"/><Button Content="自动连接已打开的战双" Click="ConnectSelectedGameClick" Style="{StaticResource QuietButton}"/><Button Content="清除目录选择" Click="ClearGameFolderClick" Style="{StaticResource QuietButton}"/></WrapPanel>
      <TextBlock x:Name="GameLocationLabel" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5"/>
      <TextBlock Text="游戏窗口" Style="{StaticResource SectionLabel}" Margin="0,12,0,6"/><ComboBox x:Name="WindowBox"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="绑定选中窗口" Click="BindWindowClick"/><Button Content="刷新窗口" Click="RefreshWindowsClick" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/></StackPanel><TextBlock x:Name="GameLabel" Text="未绑定 · 不会跟随其他应用的按键" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,5" TextWrapping="Wrap"/><TextBlock x:Name="PermissionLabel" Text="正在检查播放器权限" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,3"/>
      </StackPanel></Expander>
      <Expander Header="按键与点击位置" Margin="0,0,0,12"><StackPanel x:Name="InputSettingsContent" Margin="4,6,4,8">
      <TextBlock Text="这些是操作方式，不需要同时开启多种配音跟随。游戏文字跟随无需设置下一句按键。" FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap"/>
      <TextBlock Text="自定义按键" Style="{StaticResource SectionLabel}" Margin="0,12,0,7"/><StackPanel x:Name="KeysPanel"/>
      <TextBlock Text="使用备用按键跟随时，跟随键须与游戏的下一句键一致。" Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,8"/>
      </StackPanel></Expander>
      <Expander Header="外观与声音" Margin="0,0,0,12"><StackPanel x:Name="AppearanceSettingsContent" Margin="4,6,4,8">
      <CheckBox x:Name="ArtworkEnabledBox" Content="显示灰鸦主题插画" Checked="ArtworkChanged" Unchecked="ArtworkChanged"/>
      <TextBlock Text="静态插画随程序保存，离线可用。" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,7"/>
      <Button Content="官方素材来源 ↗" Click="ArtworkSourceClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"/>
      </StackPanel></Expander>
      <Expander Header="辅助定位与诊断" Margin="0,0,0,12"><StackPanel x:Name="DiagnosticSettingsContent" Margin="4,6,4,8">
      <CheckBox x:Name="OcrEnabledBox" Content="启用截图辅助定位（OCR）" Margin="0,4,0,7" Checked="OcrEnabledChanged" Unchecked="OcrEnabledChanged"/>
      <TextBlock Text="按需运行，关闭即释放。截图只在本机处理。" FontSize="11" Foreground="{StaticResource MutedText}"/>
      <Button Content="配置与日志文件夹 ↗" Click="OpenStateClick" Style="{StaticResource QuietButton}" Margin="0,5,0,6" HorizontalAlignment="Left"/>
      </StackPanel></Expander>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Border x:Name="PlaybackBar" Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10,16,9" Margin="0,7,0,0" Background="{StaticResource Bg}">
     <StackPanel>
      <Button x:Name="ConfirmPlayButton" Content="确认播放选中台词                         ↵" Click="ConfirmLineClick" Padding="12,9" Margin="0,0,0,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSelected,ElementName=StoryTab}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <UniformGrid x:Name="ManualPlaybackButtons" Columns="5"><Button Content="配音上一句" Click="PreviousClick" Padding="4,7" Margin="0,0,5,0"/><Button Content="重播" Click="ReplayClick" Padding="4,7" Margin="0,0,5,0"/><Button Content="配音下一句" Click="NextClick" Padding="4,7" Margin="0,0,5,0"/><Button Content="暂停/跟随" Click="PauseClick" Padding="4,7" Margin="0,0,5,0"/><Button Content="游戏原声" Click="OriginalClick" Padding="4,7"/></UniformGrid>
      <DockPanel Margin="0,8,0,3"><TextBlock Text="音量" Foreground="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="VolumeLabel" DockPanel.Dock="Right" Text="80%" Foreground="{StaticResource MutedText}" FontSize="11" Width="37" TextAlignment="Right" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" ValueChanged="VolumeChanged" Margin="10,0"/></DockPanel>
      <TextBlock x:Name="SaveWarning" Visibility="Collapsed" Foreground="{StaticResource BranchAccent}" FontSize="11"/><TextBlock x:Name="Notice" Text="F4 目录 · F6 收起 · F8 原声 · F9 定位" Foreground="{StaticResource MutedText}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>
 </Grid>
</Window>
